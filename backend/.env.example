# Sao chép file này thành .env rồi sửa cho khớp máy của bạn. KHÔNG commit file .env.

# Chọn loại CSDL:
#   sqlite -> KHÔNG cần cài MySQL, dùng file student.db tự tạo cùng dữ liệu mẫu (khuyên dùng khi demo/nộp bài)
#   mysql  -> dùng MySQL như thiết kế, cần nạp sql/schema.sql
DB_ENGINE=sqlite

# Chỉ dùng khi DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_db

# Chỉ dùng khi DB_ENGINE=sqlite: đường dẫn file CSDL (tương đối theo thư mục backend/)
# SQLITE_PATH=student.db

# Chuỗi bí mật dùng ký cookie session. Đổi thành chuỗi ngẫu nhiên dài.
SECRET_KEY=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai

# Mật khẩu ban đầu của tài khoản sinh viên mới tạo (bị buộc đổi ở lần đăng nhập đầu)
DEFAULT_STUDENT_PASSWORD=Ptit@2026

# Ảnh đại diện
UPLOAD_DIR=uploads
MAX_AVATAR_MB=2